# ============================================================================
# .env.production.template — NanoVMS OTel Stack environment variables
# ============================================================================
#
# Copy this file and fill in production values:
#   cp .env.production.template .env.production
#
# DO NOT commit .env.production to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
OTEL_ENV=production
OTEL_SERVICE_VERSION=0.1.0
OTEL_INSTANCE_ID=nanovms-collector-1

# ---------------------------------------------------------------------------
# Memory / Performance Tuning
# ---------------------------------------------------------------------------
# Collector memory limiter — set to ~80% of container memory limit
OTEL_MEM_LIMIT_MIB=512
# Spike buffer — set to ~25% of limit
OTEL_MEM_SPIKE_MIB=128
# Batch processor tuning
OTEL_BATCH_SIZE=8192
OTEL_BATCH_MAX_SIZE=16384
OTEL_BATCH_TIMEOUT=5s
# Trace sampling — percentage of traces to forward after tail-sampling
OTEL_SAMPLING_PERCENTAGE=10

# ---------------------------------------------------------------------------
# Ports (host-exposed)
# ---------------------------------------------------------------------------
# External: OTLP receivers — your apps send telemetry here
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
# Internal: monitoring endpoints — bind to 127.0.0.1 in compose
OTEL_PROM_PORT=8889
OTEL_HEALTH_PORT=13133
OTEL_ZPAGES_PORT=55679
PROM_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
# Set to 'true' only for development/self-signed certs
OTEL_TLS_INSECURE=false

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# REQUIRED: Generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ROOT_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Jaeger
# ---------------------------------------------------------------------------
# Options: badger (persistent) | memory (ephemeral, for dev only)
JAEGER_STORAGE_TYPE=badger

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Options: debug | info | warn | error
OTEL_LOG_LEVEL=info
# debug exporter verbosity: basic | normal | detailed
OTEL_DEBUG_VERBOSITY=basic

# ---------------------------------------------------------------------------
# Loki
# ---------------------------------------------------------------------------
OTEL_LOKI_TENANT=nanovms
