# .dockerignore — NanoVMS dev builds
# Enhanced from phenotype org canonical (L2 #28) for dev workflow.
# Source of truth: phenotype-org-governance/.dockerignore
# Reference: https://docs.docker.com/engine/reference/builder/#dockerignore-file

# ── Version control ──────────────────────────────────────────
.git
.gitignore
.gitattributes
.github
.circleci
.trunk
.forge
.grade-reports
.kittify

# ── Build artifacts (rebuilt inside container) ────────────────
target/
debug/
release/
dist/
build/
bin/
out/
**/target/
**/debug/
**/release/
**/build/
**/dist/
**/bin/
**/.next/
**/.nuxt/
**/.output/
**/coverage/
**/.pytest_cache/
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/
**/.coverage
**/.coverage.*

# ── Go build cache (rebuilt inside container) ─────────────────
**/go-build/
pkg/

# ── Node / JS ────────────────────────────────────────────────
node_modules/
**/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lock

# ── Rust / Go ────────────────────────────────────────────────
**/.cargo
**/vendor/
**/*.rs.bk
**/*.pdb

# ── Python ───────────────────────────────────────────────────
**/.venv/
**/venv/
**/env/
**/*.egg-info/
**/.eggs/
**/*.whl
**/*.tar.gz
**/*.pyc
**/*.py[cod]
**/*.pyo

# ── IDE / editor ─────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
**/.DS_Store
**/Thumbs.db

# ── Logs / temp ──────────────────────────────────────────────
*.log
**/*.log
*.tmp
*.bak
**/tmp/
**/temp/
worklog/
worklog-*.json

# ── Environment secrets (never in image) ─────────────────────
.env
.env.*
**/.env
**/.env.local
**/.env.*.local
!.env.example
**/.env.example

# ── CI / workflows ───────────────────────────────────────────
.github/workflows/
.gitlab-ci.yml
.drone.yml

# ── Grade reports / audit artifacts ──────────────────────────
grade_*.json
results_*.txt
audit_scorecard.json
AUDIT_SCORECARD.md
user-scorecard.json
**/*.test
**/*.test.rs

# ── Coverage / profiling ─────────────────────────────────────
*.profraw
*.profdata
llvm-cov-*

# ── Documentation (not needed in dev image) ──────────────────
docs/
**/docs/
*.md
!README.md

# ── Docker files (avoid recursive inclusion) ─────────────────
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore
Dockerfile.bak
docker-compose.override.yml

# ── Large test fixtures ──────────────────────────────────────
**/tests/fixtures/large/
**/snapshots/baselines/
